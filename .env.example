# Postgres. Neon gives you both; the unpooled/direct one is required for Prisma migrations.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Signs the session cookie. Any long random string; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me"

# Shared secret for POST /api/admin/poll, used to warm the DB after a deploy.
ADMIN_POLL_SECRET="replace-me"

# Set by the host in production.
NODE_ENV="development"
PORT="3000"
